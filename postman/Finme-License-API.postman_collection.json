{
    "info": {
        "_postman_id": "c6f5f4bb-76ad-4e06-9de0-8b1f6a8f2c43",
        "name": "Finme License API",
        "description": "Postman collection for the Finme license CRUD and activation API.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000"
        },
        {
            "key": "licenseId",
            "value": ""
        },
        {
            "key": "licenseCode",
            "value": "FINME-PRO-001"
        }
    ],
    "item": [
        {
            "name": "Health",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/health",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "health"
                    ]
                }
            }
        },
        {
            "name": "Licenses",
            "item": [
                {
                    "name": "Create license",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const response = pm.response.json();",
                                    "if (response.license && response.license._id) {",
                                    "    pm.collectionVariables.set('licenseId', response.license._id);",
                                    "}",
                                    "if (response.code) {",
                                    "    pm.collectionVariables.set('licenseCode', response.code);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Finme Pro\",\n  \"code\": \"{{licenseCode}}\",\n  \"expiresAt\": \"2027-12-31T23:59:59.000Z\",\n  \"maxActivations\": 2\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/licenses",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "licenses"
                            ]
                        }
                    }
                },
                {
                    "name": "List licenses",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/licenses",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "licenses"
                            ]
                        }
                    }
                },
                {
                    "name": "Get license",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/licenses/{{licenseId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "licenses",
                                "{{licenseId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Update license",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Finme Pro Updated\",\n  \"maxActivations\": 3\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/licenses/{{licenseId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "licenses",
                                "{{licenseId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Activate license",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"code\": \"{{licenseCode}}\",\n  \"computerId\": \"desktop-001\",\n  \"computerName\": \"DESKTOP-001\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/licenses/activate",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "licenses",
                                "activate"
                            ]
                        }
                    }
                },
                {
                    "name": "Delete license",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/licenses/{{licenseId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "licenses",
                                "{{licenseId}}"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}